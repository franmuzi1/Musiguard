# MusiGuard: timer giornaliero della pulizia automatica.
# Persistent=true recupera l'esecuzione persa se il PC era spento a mezzanotte;
# il ritardo casuale evita il picco di lavoro esattamente allo scoccare.
# Lo script ha comunque il suo lock flock: run sovrapposte non si pestano.

[Unit]
Description=MusiGuard - esegue la pulizia automatica ogni giorno

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
