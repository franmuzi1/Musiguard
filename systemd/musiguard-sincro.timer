# MusiGuard: una sincronizzazione Syncthing al giorno, di sera (quando gli
# altri dispositivi — telefono — sono più probabilmente accesi e in casa).
# Persistent=true recupera l'esecuzione persa se il PC era spento alle 20.

[Unit]
Description=MusiGuard - sincro Syncthing una volta al giorno

[Timer]
OnCalendar=*-*-* 20:00:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
